{
  "expo": {
    "name": "QuizzV",
    "slug": "QuizzV",
    "version": "1.10.0",
    "scheme": "quizzv",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kauan.quizzv",
      "buildNumber": "9",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Quiz do QuizzV",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.kauan.quizzv.qv"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.kauan.quizzv.qv",
            "UTTypeDescription": "Quiz do QuizzV",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "qv"
              ],
              "public.mime-type": [
                "application/vnd.quizzv"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.kauan.quizzv",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/vnd.quizzv"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.quizzv"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\.qv"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\..*\\.qv"
            },
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\.qv"
            },
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\..*\\.qv"
            }
          ]
        }
      ],
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "O QuizzV usa a câmera só para ler o QR code que conecta o celular a uma chamada do Vcall.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
